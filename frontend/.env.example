# LLM - use ONE of these:

# Option A: OpenAI (default)
OPENAI_API_KEY=your_openai_api_key

# Optional: faster/cheaper model (lower latency, less reasoning depth than gpt-4o)
# COPILOT_CHAT_MODEL=openai/gpt-4o-mini

# Optional: cap tool-calling iterations (1–50), default 20
# AGENT_MAX_STEPS=12

# Option B: Azure OpenAI
# AZURE_OPENAI_CHAT_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2025-01-01-preview
# AZURE_OPENAI_API_KEY=your_azure_api_key

# MCP server(s) - EASIEST: edit frontend/mcp.json (add URLs to "servers" array)
# Each MCP brings its tool descriptions automatically—no extra config.
# Env fallback:
# Single: MCP_URL=http://localhost:3100/mcp
# Multiple: MCP_URLS=http://localhost:3100/mcp,https://other-mcp.example.com/mcp
